 limits:"Concept coverage: direct substitution, limit meaning, continuity, one-sided limits, factorisation, rationalisation, infinite limits, and standard trigonometric limits.",
 functions:"Concept coverage: function evaluation, exponent laws, powers of powers, quadratic factorisation, linear equations, composition, inverse functions, domain restrictions, logarithms, and inequalities."
};
document.querySelectorAll(".topic").forEach(b=>b.addEventListener("click",()=>{document.querySelectorAll(".topic").forEach(x=>x.classList.remove("active"));b.classList.add("active");topic=b.dataset.topic;$("coverageLine").textContent=topicCoverage[topic]}));
function pickFresh(topicKey, count, phaseKey, preferredTags=[]){
 const key=`cb_seen_${topicKey}`, stemKey=`cb_seen_stems_${topicKey}`; let seen=[], seenStems=[];
 try{seen=JSON.parse(localStorage.getItem(key)||"[]")}catch(e){} try{seenStems=JSON.parse(localStorage.getItem(stemKey)||"[]")}catch(e){}
 let available=questionPool[topicKey].filter(q=>!seen.includes(q.id)&&!seenStems.includes(q.q));
 // Deduplicate identical stems in the candidate set so one test cannot repeat the same wording.
 const unique=[], stemSet=new Set(); for(const q of available){if(!stemSet.has(q.q)){stemSet.add(q.q);unique.push(q)}} available=unique;
 if(available.length<count){
   // Start a new cycle only when fewer than 10 unseen unique stems remain; never pad a test with repeats.
   seen=[];seenStems=[];const all=questionPool[topicKey],allStems=new Set();available=[];
   for(const q of all){if(!allStems.has(q.q)){allStems.add(q.q);available.push(q)}}
 }
 const quotas={easy:5,medium:3,hard:2}; let picked=[];
 for(const [level,quota] of Object.entries(quotas)){
   let tier=available.filter(q=>q.difficulty===level);
   if(preferredTags.length){const focused=tier.filter(q=>q.tags.some(t=>preferredTags.includes(t))); const rest=tier.filter(q=>!q.tags.some(t=>preferredTags.includes(t))); tier=focused.concat(rest);}
   for(let i=tier.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[tier[i],tier[j]]=[tier[j],tier[i]];}
   picked.push(...tier.slice(0,quota));
 }
 if(picked.length<count){const ids=new Set(picked.map(q=>q.id));const stems=new Set(picked.map(q=>q.q));const rest=available.filter(q=>!ids.has(q.id)&&!stems.has(q.q));for(let i=rest.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[rest[i],rest[j]]=[rest[j],rest[i]];}picked.push(...rest.slice(0,count-picked.length));}
 for(let i=picked.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[picked[i],picked[j]]=[picked[j],picked[i]];}
 picked=picked.slice(0,count); const newStems=picked.map(q=>q.q); const matchedIds=questionPool[topicKey].filter(q=>newStems.includes(q.q)).map(q=>q.id);
 seen=[...new Set([...seen,...matchedIds])]; seenStems=[...new Set([...seenStems,...newStems])];
 try{localStorage.setItem(key,JSON.stringify(seen));localStorage.setItem(stemKey,JSON.stringify(seenStems))}catch(e){}
 return picked;
}
$("start").addEventListener("click",()=>{phase="diag";questions=pickFresh(topic,10,"diag");idx=0;answers=[];$("quizTitle").textContent=topicNames[topic];show("quiz");renderQuestion()});
$("exitQuiz").addEventListener("click",()=>show("home"));
function renderQuestion(){
 const q=questions[idx];$("qcounter").textContent=`Question ${idx+1} of ${questions.length}`;$("qtopic").textContent=phase==="diag"?"Concept check":"Fresh post-test";
 $("progressbar").style.width=`${idx/questions.length*100}%`;$("qtags").innerHTML=`<span class="qtag">${({easy:"🟢 EASY",medium:"🟡 MEDIUM",hard:"🔴 HARD"})[q.difficulty]||"CONCEPT CHECK"}</span>`+q.tags.map(t=>`<span class="qtag">${concepts[t]?.name||t}</span>`).join("");
 $("question").textContent=q.q;$("options").innerHTML="";$("answerFeedback").innerHTML="";
 $("quizHint").textContent=phase==="diag"?"Take your time":"New questions test the same ideas";
 q.o.forEach((opt,i)=>{const btn=document.createElement("button");btn.className="option";btn.innerHTML=`<span class="letter">${String.fromCharCode(65+i)}</span><span>${opt}</span>`;btn.addEventListener("click",()=>{answers[idx]=i;document.querySelectorAll(".option").forEach(x=>x.classList.remove("selected"));btn.classList.add("selected");$("nextQuestion").disabled=false});$("options").appendChild(btn)});
 $("progressbar").style.width=`${(idx)/questions.length*100}%`;$("nextQuestion").disabled=true;$("nextQuestion").textContent=idx===questions.length-1?"See my concept snapshot →":"Next question →";
}
$("nextQuestion").addEventListener("click",()=>{if(answers[idx]===undefined)return;if(idx<questions.length-1){idx++;renderQuestion()}else if(phase==="diag"){processDiag()}else{processPost()}});
function processDiag(){
 diagnosticScore=questions.reduce((n,q,i)=>n+(answers[i]===q.a?1:0),0);
 const misses={};questions.forEach((q,i)=>{if(answers[i]!==q.a)q.tags.forEach(t=>misses[t]=(misses[t]||0)+1)});
 gaps=Object.entries(misses).sort((a,b)=>b[1]-a[1]).map(([id,count])=>({id,count}));
 $("scorecircle").textContent=`${diagnosticScore}/${questions.length}`;
 $("resultTitle").textContent=diagnosticScore===questions.length?"Excellent foundations!":"Let's strengthen a few foundations.";
 $("resultSummary").textContent=`You answered ${diagnosticScore} of ${questions.length} correctly. The concepts below are linked to missed answers in this diagnostic. The 100,000-question bank spans core concepts for this topic; each test has exactly 5 easy, 3 medium, and 2 hard questions.`;
 $("gapList").innerHTML="";
 if(!gaps.length){$("gapList").innerHTML=`<div class="success">🎉 No concept tags were triggered by a missed answer. Try another topic or a more challenging question set.</div>`}
 gaps.forEach(g=>{const c=concepts[g.id];if(!c)return;const el=document.createElement("div");el.className="gapcard";el.innerHTML=`<div class="gaprow"><div><h3>${c.name}</h3><p>${g.count} missed question${g.count>1?"s":""} linked to this concept</p></div><span class="severity ${g.count===1?"medium":""}">${g.count>1?"Review first":"Review next"}</span></div><div class="lesson"><strong>What to remember</strong><p>${c.lesson}</p></div>`;$("gapList").appendChild(el)});
 $("beginRevision").disabled=!gaps.length;
 show("results");
}
$("beginRevision").addEventListener("click",()=>{renderLessons();show("revision")});
function renderLessons(){
 $("lessonList").innerHTML="";
 const ids=gaps.length?gaps.map(g=>g.id):["power","functions"];
 ids.forEach((id,i)=>{const c=concepts[id];const el=document.createElement("div");el.className="gapcard";el.innerHTML=`<div class="gaprow"><div><span class="eyebrow">CONCEPT ${String(i+1).padStart(2,"0")}</span><h3 style="margin-top:5px">${c.name}</h3></div><span class="tag">~1 min</span></div><div class="lesson"><strong>Quick refresher</strong><p>${c.lesson}</p><p style="margin-top:10px"><code>${c.formula}</code></p></div><div class="practice"><h4>Try it: ${c.practice}</h4><div class="options" data-practice="${id}">${c.practiceOptions.map((o,j)=>`<button class="option" data-idx="${j}"><span class="letter">${String.fromCharCode(65+j)}</span><span>${o}</span></button>`).join("")}</div><div class="tiny" id="pract-${id}" style="margin-top:8px">Pick an answer to check your understanding.</div></div>`;$("lessonList").appendChild(el);
 const box=el.querySelector(`[data-practice="${id}"]`);box.querySelectorAll("button").forEach(btn=>btn.addEventListener("click",()=>{box.querySelectorAll("button").forEach(b=>b.classList.remove("selected"));btn.classList.add("selected");const ok=Number(btn.dataset.idx)===c.practiceAnswer;$(`pract-${id}`).innerHTML=ok?`<span style="color:#087e6f;font-weight:700">✓ Correct — nice work.</span>`:`<span style="color:#b45309;font-weight:700">Not quite yet.</span> ${c.practiceOptions[c.practiceAnswer]} is correct. Review the rule above and try another.`}))});
}
$("startPost").addEventListener("click",()=>{
 phase="post";postQuestions=[];
 const preferred=gaps.map(g=>g.id);
 postQuestions=pickFresh(topic,10,"post",preferred).map(q=>({...q,concept:q.tags[0]||"functions"}));
 questions=postQuestions;idx=0;answers=[];$("quizTitle").textContent="Fresh concept check";show("quiz");renderQuestion();
});
function processPost(){
 lastPostScore=questions.reduce((n,q,i)=>n+(answers[i]===q.a?1:0),0);
 $("postScore").textContent=`${lastPostScore}/${questions.length}`;$("beforeScore").textContent=`${diagnosticScore}/10`;$("afterScore").textContent=`${lastPostScore}/${questions.length}`;
 const before=Math.round(diagnosticScore/10*100),after=Math.round(lastPostScore/questions.length*100);const delta=after-before;
 $("deltaScore").textContent=(delta>0?"+":"")+delta+"%";
 $("postTitle").textContent=lastPostScore===questions.length?"Great work — you got them all!":lastPostScore>0?"You're building momentum.":"Keep practising, one concept at a time.";
 $("postSummary").textContent=`You scored ${lastPostScore} out of ${questions.length} on a fresh set linked to your focus concepts.`;
 $("progressInsight").textContent=delta>0?`Your score moved from ${before}% to ${after}% (+${delta} percentage points) across two different sets. This is an encouraging signal, though the sets are short and not a formal measurement.`:delta===0?`Your scores are ${before}% and ${after}%. That can happen with short tests; try another practice cycle and look for consistent improvement.`:`Your fresh-set score is lower by ${Math.abs(delta)} points. That's useful feedback: revisit the concepts and try again without rushing.`;
 const miss=questions.filter((q,i)=>answers[i]!==q.a).map(q=>q.concept);$("remainingGaps").innerHTML=miss.length?`<h3 style="font-size:15px;margin-top:18px">Concepts to revisit</h3>${[...new Set(miss)].map(id=>`<div class="gapcard"><b>${concepts[id].name}</b><p class="tiny">${concepts[id].lesson}</p></div>`).join("")}`:`<div class="success">✓ You answered every post-test question correctly. Try a new topic to continue building your concept map.</div>`;
 show("postresults");
}
$("retryHome").addEventListener("click",()=>show("home"));$("backResults").addEventListener("click",()=>show("results"));
$("again").addEventListener("click",()=>show("home"));$("reviewLessons").addEventListener("click",()=>{renderLessons();show("revision")});
</script>
