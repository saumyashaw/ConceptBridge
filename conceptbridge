function shuffledOptions(correct, distractors, tags, q, why, id, difficulty){
 const vals=[String(correct),...distractors.map(String)]; const uniq=[...new Set(vals)];
 for(let k=1;uniq.length<4;k++) if(!uniq.includes(`Option ${k}`)) uniq.push(`Option ${k}`);
 const opts=uniq.slice(0,4), correctText=String(correct);
 for(let i=opts.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[opts[i],opts[j]]=[opts[j],opts[i]];}
 return {id,q,o:opts,a:opts.indexOf(correctText),tags,why,difficulty};
}
